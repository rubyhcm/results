 counts[index[str(row.template_id)]] += 1\n","        if row.label == 'Anomaly':\n","            window_anomaly = 1\n","        position += 1\n","        if position % window_size == 0:\n","            x_rows.append([counts[i] for i in range(len(ordered))])\n","            y_rows.append(window_anomaly)\n","            sample_ids.append(f'bgl:{position - window_size}:{position}')\n","            counts = Counter()\n","            window_anomaly = 0\n","\n","    return (np.asarray(x_rows, dtype=np.float32),\n","            np.asarray(y_rows, dtype=np.int64), ordered, sample_ids)\n","\n","X_bgl, y_bgl, bgl_features, bgl_sample_ids = build_bgl_windows(bgl, WINDOW_SIZE)\n","print('BGL window shape:', X_bgl.shape)\n","print('BGL window labels:', Counter(y_bgl.tolist()))"]},{"cell_type":"markdown","id":"af61706a","metadata":{"papermill":{"duration":0.001978,"end_time":"2026-11-25T19:01:35.518456+00:00","exception":false,"start_time":"2026-11-25T19:01:35.516478+00:00","status":"completed"},"tags":[]},"source":["## 4. Split và metric"]},{"cell_type":"code","execution_count":7,"id":"9d950f18","metadata":{"execution":{"iopub.execute_input":"2026-11-25T19:01:35.523965Z","iopub.status.busy":"2026-11-25T19:01:35.523664Z","iopub.status.idle":"2026-11-25T19:01:40.042991Z","shell.execute_reply":"2026-11-25T19:01:40.041757Z"},"papermill":{"duration":4.52452,"end_time":"2026-11-25T19:01:40.044961+00:00","exception":false,"start_time":"2026-11-25T19:01:35.520441+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["HDFS split counts: {'train': 460048, 'validation': 57506, 'test': 57507}\n","BGL split counts: {'train': 18991, 'validation': 2374, 'test': 2374}\n"]}],"source":["from scripts.shared_benchmark_protocol import align_indices, load_split_table, select_f1_threshold\n","\n","hdfs_splits = align_indices(\n","    hdfs_sample_ids, y_hdfs,\n","    load_split_table(protocol_dir, 'hdfs_v1'))\n","bgl_splits = align_indices(\n","    bgl_sample_ids, y_bgl,\n","    load_split_table(protocol_dir, 'bgl'))\n","print('HDFS split counts:', {k: len(v) for k, v in hdfs_splits.items()})\n","print('BGL split counts:', {k: len(v) for k, v in bgl_splits.items()})\n","\n","def make_model(name, seed):\n","    if name == 'dt':\n","        return DecisionTreeClassifier(random_state=seed)\n","    if name == 'knn':\n","        return KNeighborsClassifier(n_neighbors=1, n_jobs=-1)\n","    if name == 'slfn':\n","        return MLPClassifier(hidden_layer_sizes=(25,), max_iter=300, random_state=seed)\n","    raise ValueError(name)\n","\n","def compute_metrics(y_true, y_pred, y_score=None):\n","    precision, recall, f1, _ = precision_recall_fscore_support(\n","        y_true, y_pred, average='binary', pos_label=1, zero_division=0\n","    )\n","    tn = int(np.sum((y_true == 0) & (y_pred == 0)))\n","    fp = int(np.sum((y_true == 0) & (y_pred == 1)))\n","    fpr = fp / (fp + tn) if fp + tn else 0.0\n","    pr_auc = None\n","    if y_score is not None and len(np.unique(y_true)) == 2:\n","        pr_auc = float(average_precision_score(y_true, y_score))\n","    return {'precision': float(precision), 'recall': float(recall),\n","            'f1': float(f1), 'fpr': float(fpr), 'pr_auc': pr_auc,\n","            'tn': tn, 'fp': fp}"]},{"cell_type":"code","execution_count":8,"id":"dbe62dd6","metadata":{"execution":{"iopub.execute_input":"2026-11-25T19:01:40.05094Z","iopub.status.busy":"2026-11-25T19:01:40.050609Z","iopub.status.idle":"2026-11-25T19:01:40.060729Z","shell.execute_reply":"2026-11-25T19:01:40.059661Z"},"papermill":{"duration":0.01572,"end_time":"2026-11-25T19:01:40.063016+00:00","exception":false,"start_time":"2026-11-25T19:01:40.047296+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def run_dataset(X, y, split_indices):\n","    all_runs = {model_name: [] for model_name in MODELS}\n","    for seed in SEEDS:\n","        train_idx = split_indices['train']\n","        val_idx = split_indices['validation']\n",